<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>

  /* ============ TOKENS ============ */
  :root{
    --white:#ffffff;
    --off-white:#FAF7FD;
    --black:#0B0B0D;
    --ink:#1A1720;
    --purple:#7C3AED;
    --purple-hover:#6A2AD9;
    --purple-deep:#3F1470;
    --purple-light:#EFE6FB;
    --text-muted:#5B5566;
    --line:#E7E1F0;
    --max:1120px;
    --radius:20px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Manrope',sans-serif;
    color:var(--ink);
    background:var(--white);
    -webkit-font-smoothing:antialiased;
    line-height:1.6;
    overflow-x:hidden;
  }
  h1,h2,h3{
    font-family:'Fraunces',serif;
    color:var(--black);
    margin:0;
    line-height:1.1;
    font-weight:700;
  }
  p{margin:0;}
  a{text-decoration:none;color:inherit;}
  img,svg{display:block;max-width:100%;}
  .container{max-width:var(--max);margin:0 auto;padding:0 24px;position:relative;}
  section{padding:96px 0;position:relative;overflow:hidden;}

  /* ============ BUTTONS ============ */
  .btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    padding:16px 34px;
    border-radius:999px;
    font-weight:700;
    font-size:1rem;
    cursor:pointer;
    border:2px solid transparent;
    transition:transform .15s ease, background .15s ease, box-shadow .15s ease;
  }
  .btn--primary{
    background:var(--purple);
    color:var(--white);
    box-shadow:0 10px 30px -8px rgba(124,58,237,.55);
  }
  .btn--primary:hover{background:var(--purple-hover); transform:translateY(-2px);}
  .btn--outline{
    background:transparent;
    color:var(--black);
    border:2px solid var(--black);
    padding:10px 22px;
    font-size:0.9rem;
  }
  .btn--outline:hover{background:var(--black); color:var(--white);}
  .btn--large{padding:20px 44px; font-size:1.1rem;}

  /* ============ HEADER ============ */
  .site-header{
    position:sticky; top:0; z-index:50;
    background:rgba(255,255,255,.9);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .site-header .container{
    display:flex; align-items:center; justify-content:space-between;
    padding-top:16px; padding-bottom:16px;
  }
  .logo{font-family:'Fraunces',serif; font-weight:700; font-size:1.15rem; color:var(--black);}
  .logo span{color:var(--purple);}

  /* ============ HERO ============ */
  .hero .container{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:56px;
    align-items:center;
  }
  .hero{padding-top:56px; padding-bottom:72px;}
  .hero__art{order:1;}
  .hero__copy{order:2;}
  .hero__title{
    font-size:clamp(2.1rem, 4.4vw, 3.3rem);
    letter-spacing:-0.01em;
  }
  .hero__sub{
    margin-top:22px;
    font-size:1.15rem;
    color:var(--text-muted);
    max-width:46ch;
  }
  .hero__actions{margin-top:34px; display:flex; align-items:center; gap:18px; flex-wrap:wrap;}
  .hero__price-note{font-size:0.92rem; color:var(--text-muted);}
  .hero__badge{
    position:absolute; top:18px; right:-6px;
    background:var(--black); color:var(--white);
    border-radius:999px; padding:10px 16px;
    font-size:0.82rem; font-weight:700;
    display:flex; align-items:center; gap:6px;
    box-shadow:0 12px 26px -10px rgba(0,0,0,.5);
  }
  .hero__art svg{animation:riseIn .9s ease both;}
  .hero__copy > *{animation:riseIn .9s ease both;}
  .hero__copy .hero__sub{animation-delay:.1s;}
  .hero__copy .hero__actions{animation-delay:.2s;}
  @keyframes riseIn{
    from{opacity:0; transform:translateY(16px);}
    to{opacity:1; transform:translateY(0);}
  }
  @media (prefers-reduced-motion: reduce){
    .hero__art svg, .hero__copy > *{animation:none;}
  }

  /* ============ PAIN POINTS ============ */
  .pain{background:var(--black); color:var(--white);}
  .pain__blob{position:absolute; top:-120px; right:-140px; width:420px; height:420px; border-radius:50%;
    background:radial-gradient(circle, rgba(124,58,237,.35), transparent 70%); pointer-events:none;}
  .pain__intro{
    display:grid; grid-template-columns:auto 1fr; gap:22px; align-items:center; margin-bottom:56px;
  }
  .pain h2{color:var(--white); font-size:clamp(1.8rem,3.2vw,2.5rem); max-width:14ch;}
  .pain__lede{color:#C9C2D6; font-size:1.05rem; max-width:44ch; margin-top:10px;}
  .pain__scribble{width:64px; height:64px; flex:0 0 auto;}
  .pain__grid{
    display:grid; grid-template-columns:1fr 1fr; gap:28px;
    position:relative; z-index:1;
  }
  .pain__item{
    display:flex; gap:18px; align-items:flex-start;
    padding:26px; border:1px solid #2A2531; border-radius:var(--radius);
    background:#141019;
  }
  .pain__icon{
    flex:0 0 auto; width:60px; height:60px; border-radius:16px;
    background:var(--purple); display:flex; align-items:center; justify-content:center;
    color:var(--white);
  }
  .pain__text{color:#E7E2EE; font-size:1rem;}

  /* ============ AHA ============ */
  .aha{background:var(--off-white); text-align:center;}
  .aha__bulb{width:110px; margin:0 auto 18px;}
  .aha__lede{color:var(--purple); font-weight:700; font-size:1rem; margin-bottom:6px;}
  .aha__statement{
    font-size:clamp(1.7rem, 3.6vw, 2.7rem);
    max-width:20ch;
    margin:0 auto;
  }
  .aha__shift{
    margin-top:48px; display:flex; align-items:center; justify-content:center; gap:24px;
    flex-wrap:wrap;
  }
  .aha__state{
    display:flex; flex-direction:column; align-items:center; gap:12px;
    background:var(--white); border:1px solid var(--line); border-radius:var(--radius);
    padding:26px 30px; width:220px;
  }
  .aha__state svg{width:44px; height:44px;}
  .aha__state span{font-weight:700; font-family:'Fraunces',serif; color:var(--black);}
  .aha__state small{color:var(--text-muted); font-size:0.85rem;}
  .aha__arrow{width:48px; height:24px; color:var(--purple);}
  .aha__panel{
    margin-top:44px;
    background:var(--white);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:32px;
    max-width:680px;
    margin-left:auto; margin-right:auto;
    box-shadow:0 24px 60px -30px rgba(76,29,149,.35);
  }
  .aha__panel p{font-size:1.1rem; color:var(--ink); font-family:'Fraunces',serif; font-weight:600;}

  /* ============ SOLUTION ============ */
  .solution__head{max-width:640px; margin-bottom:44px;}
  .solution__head h2{font-size:clamp(1.9rem,3.4vw,2.6rem);}
  .solution__head p{margin-top:16px; color:var(--text-muted); font-size:1.1rem;}
  .solution__grid{
    display:grid; grid-template-columns:1fr 1fr; gap:28px; margin-bottom:52px;
  }
  .solution__card{
    padding:30px; border-radius:var(--radius); background:var(--off-white);
    border:1px solid var(--line);
  }
  .solution__icon{
    width:56px; height:56px; border-radius:16px;
    background:var(--purple); color:var(--white);
    display:flex; align-items:center; justify-content:center;
    margin-bottom:20px;
  }
  .solution__card h3{font-size:1.25rem; margin-bottom:10px;}
  .solution__card p{color:var(--text-muted); font-size:0.98rem;}

  .roadmap{
    display:flex; align-items:flex-start; justify-content:center; flex-wrap:wrap;
    gap:0; padding:32px 20px; background:var(--purple-light); border-radius:var(--radius);
  }
  .roadmap__node{display:flex; flex-direction:column; align-items:center; gap:10px; width:78px;}
  .roadmap__circle{
    width:52px; height:52px; border-radius:50%; background:var(--white); border:2px solid var(--purple);
    display:flex; align-items:center; justify-content:center; font-family:'Fraunces',serif; font-weight:700;
    color:var(--purple-deep); font-size:1.1rem;
  }
  .roadmap__node--bonus .roadmap__circle{background:var(--purple); color:var(--white); border-color:var(--purple);}
  .roadmap__node span{font-size:0.78rem; color:var(--purple-deep); font-weight:700; text-align:center;}
  .roadmap__chevron{color:var(--purple); align-self:center; margin-top:14px; font-size:1.4rem; width:20px; text-align:center;}

  /* ============ PROOF ============ */
  .proof{background:var(--off-white);}
  .proof__head{text-align:center; max-width:520px; margin:0 auto 52px;}
  .proof__head h2{font-size:clamp(1.8rem,3.2vw,2.4rem);}
  .proof__rating{display:flex; align-items:center; justify-content:center; gap:10px; margin-top:16px;}
  .proof__rating-score{font-family:'Fraunces',serif; font-weight:700; font-size:1.4rem; color:var(--black);}
  .proof__rating-stars{display:flex; gap:2px;}
  .proof__rating-note{color:var(--text-muted); font-size:0.92rem;}
  .proof__grid{display:grid; grid-template-columns:repeat(3,1fr); gap:26px;}
  .proof__card{
    background:var(--white); border:1px solid var(--line); border-radius:var(--radius);
    padding:28px; position:relative;
  }
  .proof__quotemark{
    position:absolute; top:14px; right:20px; font-family:'Fraunces',serif; font-size:3.2rem;
    color:var(--purple-light); line-height:1; user-select:none;
  }
  .proof__stars{display:flex; gap:4px; margin-bottom:16px;}
  .proof__quote{font-size:1rem; color:var(--ink); font-style:italic; position:relative; z-index:1;}
  .proof__who{margin-top:20px; display:flex; align-items:center; gap:12px;}
  .proof__avatar{
    width:40px; height:40px; border-radius:50%; color:var(--white); font-weight:700;
    display:flex; align-items:center; justify-content:center; font-family:'Fraunces',serif; flex:0 0 auto;
  }
  .proof__name{font-size:0.9rem; color:var(--text-muted); font-weight:700;}

  /* ============ OFFER ============ */
  .offer{
    position:relative; overflow:hidden;
    background:linear-gradient(165deg, var(--black) 0%, #1B0E30 100%);
    color:var(--white); text-align:center;
  }
  .offer::before{
    content:"";
    position:absolute; top:-160px; left:50%; transform:translateX(-50%);
    width:640px; height:640px; border-radius:50%;
    background:radial-gradient(circle, rgba(124,58,237,.5), transparent 70%);
    filter:blur(10px);
  }
  .offer .container{z-index:1;}
  .offer__lede{color:#C9C2D6; margin-bottom:10px; font-size:1rem;}
  .offer__title{color:var(--white); font-size:clamp(2rem,4vw,2.9rem);}
  .offer__subtitle{margin-top:14px; color:#D8D2E4; font-size:1.1rem; max-width:46ch; margin-left:auto; margin-right:auto;}
  .offer__ticket{
    position:relative; z-index:1; margin:40px auto 0; max-width:420px;
    background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.22);
    border-radius:24px; padding:36px 40px;
  }
  .offer__amount{font-family:'Fraunces',serif; font-size:clamp(3rem,6vw,4.2rem); font-weight:800;}
  .offer__terms{color:#B9B0CB; font-size:0.95rem; margin-top:4px;}
  .offer__divider{position:relative; border-top:2px dashed rgba(255,255,255,.3); margin:26px 0;}
  .offer__divider::before,.offer__divider::after{
    content:""; position:absolute; top:-13px; width:26px; height:26px; border-radius:50%;
    background:#150A26;
  }
  .offer__divider::before{left:-52px;}
  .offer__divider::after{right:-52px;}
  .offer__bonus{display:flex; align-items:center; justify-content:center; gap:10px; color:#E9E1FB; font-weight:700; font-size:0.98rem;}
  .offer__bonus svg{width:24px; height:24px; color:var(--purple-light);}
  .offer__cta{margin-top:34px;}
  .offer__note{margin-top:18px; color:#9A93AC; font-size:0.88rem;}

  /* ============ FOOTER ============ */
  .footer{padding:48px 0; text-align:center;}
  .footer__brand{font-family:'Fraunces',serif; font-weight:700; font-size:1.05rem;}
  .footer__copy{margin-top:8px; color:var(--text-muted); font-size:0.85rem;}

  /* ============ RESPONSIVE ============ */
  @media (max-width: 900px){
    section{padding:64px 0;}
    .hero .container{grid-template-columns:1fr; gap:36px;}
    .hero__art{order:1; max-width:340px; margin:0 auto; position:relative;}
    .hero__copy{order:2; text-align:center;}
    .hero__sub{margin-left:auto; margin-right:auto;}
    .hero__actions{justify-content:center;}
    .pain__intro{grid-template-columns:1fr; text-align:center; justify-items:center;}
    .pain__grid{grid-template-columns:1fr;}
    .solution__grid{grid-template-columns:1fr;}
    .roadmap{gap:0;}
    .proof__grid{grid-template-columns:1fr;}
    .aha__shift{gap:14px;}
    .aha__arrow{transform:rotate(90deg); width:24px; height:24px;}
    .offer__divider::before{left:-13px;}
    .offer__divider::after{right:-13px;}
  }
</style>
</head>
